# رابط قاعدة بيانات MongoDB Atlas
# غيّر YOUR_USER وYOUR_PASS وYOUR_CLUSTER بالقيم الحقيقية
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@YOUR_CLUSTER.mongodb.net/ma3gon

# سر توقيع الـ JWT — لازم تكون قيمة عشوائية طويلة في الإنتاج (32+ حرف)
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=24h

# باسورد الأدمن الافتراضي أول ما تتعمل الداتابيز (Seed)
# لازم تغيّره من لوحة الإعدادات بعد أول تشغيل
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ON_FIRST_RUN

# البورت
PORT=3000

# الروابط المسموح لها تتكلم مع الـ API (CORS) — افصل بينهم بفاصلة
CORS_ORIGINS=https://your-frontend.vercel.app
